#!/bin/sh
set -eu

app_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
app_jar="$app_root/target/rsc-sprite-baker.jar"

java_cmd=java
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  java_cmd="$JAVA_HOME/bin/java"
fi
if ! command -v "$java_cmd" >/dev/null 2>&1; then
  echo "RSC Sprite Baker requires Java 11 or newer." >&2
  exit 1
fi
java_major=$($java_cmd -version 2>&1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -n 1)
if [ -z "$java_major" ] || [ "$java_major" -eq 1 ] || [ "$java_major" -lt 11 ]; then
  echo "RSC Sprite Baker requires Java 11 or newer. Set JAVA_HOME to a compatible JDK." >&2
  exit 1
fi
if [ ! -f "$app_jar" ]; then
  echo "Application JAR not found: $app_jar" >&2
  echo "Build it with: mvn clean package" >&2
  exit 1
fi

exec "$java_cmd" -jar "$app_jar" "$@"
